{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints",
    "src",
    "scripts",
    "wxt.config.ts",
