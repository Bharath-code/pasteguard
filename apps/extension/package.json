{
  "name": "@pasteguard/extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "zip": "wxt zip",
    "size": "node scripts/size.mjs",
